# DEV-TO-DEV Environment Variables

# Database
DATABASE_URL=""

# Redis
REDIS_URL="redis://localhost:6379"

# API & Services
DEV_MIND_URL="http://localhost:8000"

# Application URLs (production: https://devtodev.online)
FRONTEND_URL="https://devtodev.online"
API_URL="https://devtodev.online"

# Security / Authentication (Future)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET=""

YOUTUBE_API_KEY=PASTE_YOUR_GOOGLE_API_KEY_HERE

# Email (Resend)
RESEND_API_KEY=""
MAIL_FROM="DEV-TO-DEV <no-reply@devtodev.online>"

# Web Push (VAPID) — Phase 4 mobile/OS notifications
# Generate a key pair locally:  pnpm dlx web-push generate-vapid-keys
# VAPID_SUBJECT must be a "mailto:" or "https:" URL.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@devtodev.online"
