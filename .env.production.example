# DEV-TO-DEV Production Environment Variables (Railway)
# Copy these into Railway's service/environment variables. Never commit real values.

# Node environment (required for secure cookies + production behavior)
NODE_ENV="production"

# Application URLs (public)
FRONTEND_URL="https://devtodev.online"
API_URL="https://devtodev.online"
# Internal URL the web service uses to reach the API service (Railway private network)
INTERNAL_API_URL="http://api:3001"

# Database (Neon — PostgreSQL with pgvector)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/database?sslmode=require"

# Redis (Railway Redis plugin, Upstash, or other managed Redis)
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# API & Services
DEV_MIND_URL="http://dev-mind:8000"

# Authentication (GitHub OAuth app / Google OAuth client)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET=""

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Video (YouTube Data API)
YOUTUBE_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
MAIL_FROM="DEV-TO-DEV <no-reply@devtodev.online>"
