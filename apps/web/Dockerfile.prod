FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NODE_OPTIONS="--dns-result-order=ipv4first"
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Build-time API rewrite target. Next.js bakes this into its routes manifest
# during `next build`, so it must be supplied at image build time via
# `docker build --build-arg INTERNAL_API_URL=...` (Railway build argument).
# A runtime-only variable is ignored for rewrites. When omitted, Next.js falls
# back to its own default in next.config.ts.
ARG INTERNAL_API_URL
ENV INTERNAL_API_URL=${INTERNAL_API_URL}

RUN npm install -g pnpm@11.13.1

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter web build
RUN chown -R node:node /app/apps/web/.next

# Run as the unprivileged `node` user provided by the base image. `.next` is
# owned by `node` so Next.js can write its incremental cache at runtime.
ENV HOME=/home/node
USER node

EXPOSE 3000
CMD ["pnpm", "--filter", "web", "start"]
